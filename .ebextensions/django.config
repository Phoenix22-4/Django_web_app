option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: AquaGuard.wsgi:application
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: AquaGuard.settings

container_commands:
  01_migrate:
    # Use a wildcard (*) to find the correct virtual environment path
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    # Use a wildcard (*) here as well
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"

# --- THIS IS THE CORRECTED SECTION ---
# We are now telling it to install the correct package for the new server.
packages:
  yum:
    libpq-devel: []
